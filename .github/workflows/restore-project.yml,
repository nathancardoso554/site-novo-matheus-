
name: Restore project folders

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  restore:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Extract original project
        shell: bash
        run: |
          set -euo pipefail

          ZIP="site-com-antes-e-depois-adicionado.zip"

          if [ ! -f "$ZIP" ]; then
            echo "ZIP not found: $ZIP"
            exit 1
          fi

          mkdir -p /tmp/project
          unzip -q "$ZIP" -d /tmp/project

          API_FILE="$(find /tmp/project -type f -path '*/api/index.mjs' -print -quit)"

          if [ -z "$API_FILE" ]; then
            echo "Could not find api/index.mjs in the ZIP."
            exit 1
          fi

          PROJECT_ROOT="${API_FILE%/api/index.mjs}"

          find . -mindepth 1 -maxdepth 1 \
            ! -name .git \
            ! -name .github \
            ! -name "$ZIP" \
            -exec rm -rf {} +

          cp -a "$PROJECT_ROOT"/. .

          test -f api/index.mjs
          test -d client
          test -d server

      - name: Commit restored folders
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "Restore original project folder structure"
          git push
